{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/types/tsconfig.tsbuildinfo"
  },
  "include": [
    "src"
  ]
}
