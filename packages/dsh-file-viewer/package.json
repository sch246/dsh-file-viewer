{
  "name": "@dsh-external/dsh-file-viewer",
  "version": "0.1.0",
  "description": "Session-scoped text document platform and workspace file viewer for DeepSeek Harness Web",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": { "build": "bash ../../scripts/build-host.sh", "typecheck": "bash ../../scripts/typecheck-host.sh" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@dsh-external/dsh-right-sidebar"
      ],
      "external": ["@dsh-external/dsh-file-viewer-editor/client"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@dsh-external/dsh-file-viewer-editor": "0.1.0",
    "@dsh-external/dsh-right-sidebar": "0.0.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@dsh-external/dsh-file-viewer-editor": "workspace:^"
  }
}
