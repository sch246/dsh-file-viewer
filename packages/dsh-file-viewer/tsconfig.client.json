{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "declaration": true, "declarationMap": true, "sourceMap": true,
    "composite": true, "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "rootDir": "src", "outDir": "lib/types", "tsBuildInfoFile": "lib/types/tsconfig.client.tsbuildinfo"
  },
  "include": ["src/client"]
}
